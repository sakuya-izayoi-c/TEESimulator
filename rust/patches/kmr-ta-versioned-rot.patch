+/// Root of Trust as a record that predates KeyMint 4 carries it: the three-element form.
+/// `verifiedBootHash` arrived with that version, and a record that declares an older version while
+/// carrying the fourth element is structurally inconsistent, whatever the element's value.
+#[derive(Debug, Clone, Sequence)]
+struct RootOfTrustV3<'a> {
+    #[asn1(type = "OCTET STRING")]
+    verified_boot_key: &'a [u8],
+    device_locked: bool,
+    verified_boot_state: VerifiedBootState,
+}
+
+/// Encode the root of trust that a record declaring `attestation_version` has to carry.
+fn encode_root_of_trust(
+    boot_info: &keymint::BootInfo,
+    attestation_version: i32,
+) -> der::Result<Vec<u8>> {
+    if attestation_version >= 400 {
+        return RootOfTrust::from(boot_info).to_der();
+    }
+    let verified_boot_key: &[u8] = if boot_info.verified_boot_key.is_empty() {
+        // If an empty verified boot key was passed by the boot loader, set the verified boot
+        // key in the attestation to all zeroes.
+        &EMPTY_BOOT_KEY[..]
+    } else {
+        &boot_info.verified_boot_key[..]
+    };
+    RootOfTrustV3 {
+        verified_boot_key,
+        device_locked: boot_info.device_boot_locked,
+        verified_boot_state: boot_info.verified_boot_state.into(),
+    }
+    .to_der()
+}
