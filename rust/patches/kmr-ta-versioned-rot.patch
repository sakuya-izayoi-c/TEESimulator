+/// A RootOfTrust that is already DER-encoded, emitted verbatim.
+///
+/// The concrete schema was checked at construction (see `encode_root_of_trust`).
+struct EncodedRootOfTrust<'a>(&'a [u8]);
+
+impl der::Encode for EncodedRootOfTrust<'_> {
+    fn encoded_len(&self) -> der::Result<der::Length> {
+        der::Length::try_from(self.0.len())
+    }
+
+    fn encode(&self, encoder: &mut impl der::Writer) -> der::Result<()> {
+        encoder.write(self.0)
+    }
+}
+
 fn asn1_root_of_trust(
     tag: Tag,
     rot: Option<&[u8]>,
-) -> der::Result<Option<ExplicitTaggedValue<RootOfTrust<'_>>>> {
+) -> der::Result<Option<ExplicitTaggedValue<EncodedRootOfTrust<'_>>>> {
     match rot {
-        Some(rot) => Ok(Some(ExplicitTaggedValue::new(tag, RootOfTrust::from_der(rot)?))),
+        Some(rot) => Ok(Some(ExplicitTaggedValue::new(tag, EncodedRootOfTrust(rot)))),
         None => Ok(None),
     }
 }
